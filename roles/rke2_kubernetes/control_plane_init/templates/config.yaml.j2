token: "{{ rke2_token_secret }}"
tls-san:
  - "{{ kube_vip_address }}"
{% if rke2_controlplane_node_taint | bool %}
node-taint:
  - "node-role.kubernetes.io/control-plane=true:NoSchedule"
{% endif %}
cni: "{{ cni_plugin }}"
{% if cni_plugin == 'cilium' %}
disable-kube-proxy: true
{% endif %}
disable:
  - rke2-ingress-nginx
  - rke2-traefik
  - rke2-traefik-crd
disable-cloud-controller: true